<%- include('partials/header', { title: 'Staff & Judiciary Directory | Department of Justice', activePage: 'staff', script: '/js/staff.js' }) %>

  <!-- Title Banner (Extends behind Liquid Glass Header) -->
  <section class="bg-slate-900 text-white pt-28 pb-10 border-b border-slate-800">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl">
        <div class="flex items-center space-x-3 mb-2">
          <img src="/assets/sanandreaslogo.png" alt="San Andreas Seal" class="h-6 w-6">
          <span class="text-doj-gold text-xs font-bold uppercase tracking-widest">Leadership & Personnel Roster</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-bold font-serif mb-3">DOJ Staff Directory</h2>
        <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
          Official roster of presiding Justices, District Attorneys, Public Defenders, and licensed Bar Association trial attorneys in San Andreas.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter & Search Controls -->
  <section class="bg-white border-b border-slate-200 py-6 sticky top-[80px] z-30 shadow-sm">
    <div class="container mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="relative w-full md:w-96">
        <input id="staff-search-input" type="text" placeholder="Search staff member by name or title..." class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-doj-gold">
        <svg class="w-4 h-4 text-slate-400 absolute left-3.5 top-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </div>

      <div class="w-full md:w-auto">
        <select id="staff-dept-filter" class="px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium text-slate-700 focus:outline-none">
          <option value="all">All Departments</option>
          <option value="judiciary">Judiciary (Judges)</option>
          <option value="district attorney">District Attorney's Office</option>
          <option value="public attorney">Public Defender Division</option>
          <option value="private lawyers">Private Bar Lawyers</option>
        </select>
      </div>
    </div>
  </section>

  <!-- Staff Grid -->
  <main class="container mx-auto px-6 py-10 flex-1">
    <div id="staff-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <!-- Populated dynamically by /js/staff.js -->
    </div>
  </main>

<%- include('partials/footer') %>
